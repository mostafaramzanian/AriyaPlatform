# Next.js Frontend Environment — copy to apps/web/.env.local for local dev.
#
# GAP-ENV-1 contract:
#   - NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time.
#     Changing them after `next build` / image build does nothing.
#   - NEXT_PUBLIC_API_URL must be `<origin>/api`. The API's global prefix is
#     `api` and the code appends `/v1` itself (src/lib/constants.ts), so a bare
#     origin produces http://host/v1/* — a path that exists nowhere.
#   - For local dev the API listens on http://localhost:3001.
#
# Public app URL (canonical/sitemap/share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API base URL — MUST end with /api.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_API_VERSION=v1

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_CLARITY_ID=

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags
NEXT_PUBLIC_ENABLE_DEMO_BOOKING=true
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_PARTNER_PORTAL=true

# External Services
NEXT_PUBLIC_CALENDAR_API_URL=
