{
  "name": "@aria-erp/api",
  "version": "1.0.0",
  "description": "Aria ERP - NestJS Backend API",
  "private": true,
  "author": "Aria ERP",
  "license": "Proprietary",
  "scripts": {
    "prebuild": "rimraf dist src/generated",
    "build": "npm run prisma:generate && nest build",
    "postbuild": "node -e \"const fs=require('fs'); const path=require('path'); const src='src/generated'; const dst='dist/generated'; if (fs.existsSync(src)) { fs.rmSync(dst,{recursive:true,force:true}); fs.mkdirSync(path.dirname(dst),{recursive:true}); fs.cpSync(src,dst,{recursive:true}); }\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./jest-e2e.json --detectOpenHandles --forceExit",
    "test:e2e:financial-check": "jest --config ./jest-e2e.json --runInBand test/financial-check-issuance.e2e-spec.ts",
    "test:e2e:ci": "jest --config ./jest-e2e.json --runInBand test/financial-check-issuance.e2e-spec.ts",
    "test:architecture": "jest --runInBand src/architecture-boundaries.spec.ts",
    "test:policy": "jest --runInBand src/runtime-policy.spec.ts",
    "arch:policy": "ts-node scripts/emit-runtime-policy.ts",
    "prisma:verify:enums": "jest --runInBand src/prisma-drift-guard.spec.ts",
    "docker:verify:artifacts": "jest --runInBand src/docker-artifact-guard.spec.ts",
    "verify:drift": "npm run test:policy && npm run prisma:verify:enums && npm run docker:verify:artifacts",
    "db:migrate": "echo 'ATTENTION: db:migrate is an all-owner orchestration for full-stack development. For production deployments use the owner-specific db:migrate:* commands.' && npm run prisma:migrate:core && npm run prisma:migrate:cms && npm run prisma:migrate:observability && npm run prisma:migrate:correspondence && npm run prisma:migrate:hr && npm run prisma:migrate:commerce && npm run prisma:migrate:production && npm run prisma:migrate:financial",
    "db:seed": "ts-node prisma/seed.ts",
    "prisma:generate:core": "prisma generate --schema=prisma/core/schema.prisma",
    "prisma:generate:cms": "prisma generate --schema=prisma/cms/schema.prisma",
    "prisma:generate:observability": "prisma generate --schema=prisma/observability/schema.prisma",
    "prisma:generate:correspondence": "prisma generate --schema=prisma/correspondence/schema.prisma",
    "prisma:generate:hr": "prisma generate --schema=prisma/hr/schema.prisma",
    "prisma:generate:commerce": "prisma generate --schema=prisma/commerce/schema.prisma",
    "prisma:generate:production": "prisma generate --schema=prisma/production/schema.prisma",
    "prisma:generate:financial": "prisma generate --schema=prisma/financial/schema.prisma",
    "prisma:generate": "npm run prisma:generate:core && npm run prisma:generate:cms && npm run prisma:generate:observability && npm run prisma:generate:correspondence && npm run prisma:generate:hr && npm run prisma:generate:commerce && npm run prisma:generate:production && npm run prisma:generate:financial",
    "prisma:migrate:core": "prisma migrate deploy --schema=prisma/core/schema.prisma",
    "prisma:migrate:cms": "prisma migrate deploy --schema=prisma/cms/schema.prisma",
    "prisma:migrate:observability": "prisma migrate deploy --schema=prisma/observability/schema.prisma",
    "prisma:migrate:correspondence": "prisma migrate deploy --schema=prisma/correspondence/schema.prisma",
    "prisma:migrate:hr": "prisma migrate deploy --schema=prisma/hr/schema.prisma",
    "prisma:migrate:commerce": "prisma migrate deploy --schema=prisma/commerce/schema.prisma",
    "prisma:migrate:production": "prisma migrate deploy --schema=prisma/production/schema.prisma",
    "prisma:migrate:financial": "prisma migrate deploy --schema=prisma/financial/schema.prisma"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-ws": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/websockets": "^12.0.0",
    "@opentelemetry/api": "^1.6.0",
    "@prisma/client": "^5.8.0",
    "@types/sanitize-html": "^2.16.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.3",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "date-fns": "^2.30.0",
    "docx": "9.8.1",
    "exceljs": "4.4.0",
    "form-data": "^4.0.6",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.13.8",
    "minio": "^7.0.21",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^5.8.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.5",
    "rxjs": "7.8.2",
    "sanitize-html": "^2.18.0",
    "ws": "^8.22.0",
    "xss": "^1.0.15",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^12.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "globals": "^14.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
