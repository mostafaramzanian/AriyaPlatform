# NestJS Backend Configuration
#
# GAP-ENV-1 — FILE-PER-CONSUMER CONTRACT (which file each tool actually reads):
#
#   apps/api/.env        — Prisma CLI (migrate/validate/generate) and the
#                          generated Prisma clients at import time. Required for
#                          host-side database commands. NEVER committed.
#   apps/api/.env.local  — the NestJS application (ConfigModule envFilePath) when
#                          running on the host. Containers ship NO env file and
#                          receive everything from the orchestrator.
#   apps/api/.env.e2e    — the Jest e2e harness (tracked; test-only).
#   .env                 — repository-root file read by `docker compose` for
#                          ${VAR} interpolation only (e.g. OPENAI_API_KEY).
#   apps/web/.env.local  — Next.js dev server / `next build` on the host.
#
# Copy this file to BOTH .env and .env.local when configuring a dev machine —
# the two consumers must agree. See docs/DEPLOYMENT.md.

# Server
PORT=3001
CMS_PORT=3002
NODE_ENV=development

# Owned datasources. Prisma schemas and migration commands are listed in ADR-0005.
# Core: required by every current runtime; migrate with `npm run db:migrate:core`.
CORE_DATABASE_URL=postgresql://aria_user:aria_password@localhost:5433/core_db
# CMS: required by combined/CMS runtimes; migrate with `npm run db:migrate:cms`.
CMS_DATABASE_URL=postgresql://aria_user:aria_password@localhost:5433/cms_db
# `DATABASE_URL` belongs only to the retained legacy Prisma history and is not a runtime contract.

# Correspondence database (Phase 50-MOD-CORR; required by combined runtime)
# Migrate with `npm run db:migrate:correspondence`.
#
# Correspondence / مکاتبات اداری owns this database, its Prisma project
# (prisma/correspondence/schema.prisma), its migration history and its generated
# client — the same mechanism CMS uses for cms_db.
#
# CORE_DATABASE_URL MUST NOT BE REUSED HERE. Pointing correspondence at core_db would
# leave the module inside Core's persistence boundary, which is exactly what this
# phase removes; the module's architectural regression test asserts that no
# correspondence code path reaches Core's Prisma client.
CORRESPONDENCE_DATABASE_URL=postgresql://aria_user:aria_password@localhost:5433/correspondence_db

# HR database (Phase 51-HR-1; required by the combined runtime)
# Migrate with `npm run db:migrate:hr`.
#
# Human Resources (منبع انسانی) owns this database, its Prisma project
# (prisma/hr/schema.prisma), its migration history and its generated client — the same
# mechanism CMS and Correspondence use.
#
# CORE_DATABASE_URL MUST NOT BE REUSED HERE: an employee may never have a login, and a
# deleted login must not delete personnel history. The module's boundary test asserts
# that no HR code path reaches Core's Prisma client.
HR_DATABASE_URL=postgresql://aria_user:aria_password@localhost:5433/hr_db

# Commerce database (Phase C1; required by the combined runtime once the Commerce
# module is composed)
# Migrate with `npm run db:migrate:commerce`.
#
# Commerce / تجارت و خرید owns this database, its Prisma project
# (prisma/commerce/schema.prisma), its migration history and its generated client —
# the same mechanism HR, CMS and Correspondence use. While the Commerce owner is a
# declared `target` (Phase C1 steps A–E), every runtime marks this datasource
# `not-used` and opens no connection.
#
# CORE_DATABASE_URL and HR_DATABASE_URL MUST NOT BE REUSED HERE: purchase documents,
# workflow history and payment/receiving/return ledgers have lifecycles independent
# of Core identity and HR employment, and the module's boundary test asserts that no
# Commerce code path reaches another owner's Prisma client.
COMMERCE_DATABASE_URL=postgresql://aria_user:aria_password@localhost:5433/commerce_db

# Production BOM database (Phase PRODUCTION-BOM-HEADER; required by the combined runtime
# once the Production module is composed)
# Migrate with `npm run db:migrate:production`; regenerate its client with
# `npm run prisma:generate:production`.
#
# Production owns this database, its Prisma project (prisma/production/schema.prisma), its
# migration history and its generated client — the same mechanism HR, CMS, Correspondence
# and Commerce use. It is an independent bounded context: required in `combined`, `cms`,
# `hr`, `correspondence`, `purchase` and `future-hr`; `not-used` in `core`.
#
# CORE_DATABASE_URL, HR_DATABASE_URL and COMMERCE_DATABASE_URL MUST NOT BE REUSED HERE:
# BOM headers, their lifecycle state and their approver snapshots have a lifecycle
# independent of Core identity, HR employment and Commerce purchases, and the module's
# boundary test asserts that no Production code path reaches another owner's Prisma client.
PRODUCTION_DATABASE_URL=postgresql://aria_user:aria_password@localhost:5433/production_db

# Observability database (Phase 49M-2; optional and non-blocking for Core)
# Migrate with `npm run db:migrate:observability` when persistence is enabled.
#
# A THIRD, PHYSICALLY SEPARATE database in the SAME Postgres cluster — not a second
# server, and never core_db. `core_db."AuditLog"` already holds ~36k rows / 17 MB of
# mostly validation/authorization noise; request-level application logging on top of
# that would put an unbounded, retention-managed write workload on the same disk, WAL
# and connection pool as identity, RBAC and every business transaction.
#
# CORE_DATABASE_URL MUST NOT BE REUSED HERE. Pointing this at core_db would defeat the
# entire separation and would let a retention DELETE compete with a login.
OBSERVABILITY_DATABASE_URL=postgresql://aria_user:aria_password@localhost:5433/observability_db

# Observability behaviour (Phase 49M-2)
#
# LOG_LEVEL is the EXISTING pino level and is reused verbatim — the observability
# writer honours the same threshold rather than introducing a second one.
LOG_LEVEL=info
# Retention windows, in days. Different per category on purpose: a debug log is worth
# days, an audit row is worth years, and a security event sits between the two.
# 0 disables the pass for that category (nothing is ever deleted).
LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=730
SECURITY_EVENT_RETENTION_DAYS=365
LIFECYCLE_RETENTION_DAYS=90
# Bounded queue + batch flush for the DROPPABLE log path. Every value is finite: an
# unbounded queue is a memory leak with a nicer name.
OBSERVABILITY_QUEUE_MAX=5000
OBSERVABILITY_BATCH_SIZE=200
OBSERVABILITY_FLUSH_INTERVAL_MS=2000
OBSERVABILITY_WRITE_TIMEOUT_MS=5000
# Set to false to disable persistence entirely; pino stdout logging continues either
# way, so turning this off degrades observability rather than breaking the app.
OBSERVABILITY_ENABLED=true

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://aria:aria_password@localhost:5672

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Host/port the API itself dials to reach MinIO (server-to-server, inside the network).
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_BUCKET=aria-erp
# Region used to build the SigV4 credential scope. Set it, otherwise the SDK resolves the
# bucket location over the network at signing time — against MINIO_PUBLIC_URL, which the
# API container usually cannot reach.
MINIO_REGION=us-east-1
# Phase 49G-5 — the BROWSER-reachable origin of MinIO, not the internal service name.
# Attachment downloads are short-lived presigned URLs and SigV4 signs the Host header, so
# the origin is fixed at signing time and must match the origin the browser requests:
#   local docker compose -> http://localhost:9000
#   deployed             -> https://files.your-domain.example
# A wrong value yields URLs with a valid signature that the browser cannot reach; leaving
# it unset falls back to the internal endpoint, which only resolves server-side.
MINIO_PUBLIC_URL=http://localhost:9000

# JWT
JWT_SECRET=dev-secret-key-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
# Legacy access-token lifetime. Unset means `15m`, which is what this repository has always
# minted; the login path used to hard-code `15m` while the refresh path read this variable.
JWT_EXPIRES_IN=15m
JWT_LEGACY_HS256_SUNSET=

# Token contract (Phase 51-HR-ARCH-3A / ADR-0006). ALL OF THESE ARE OPTIONAL, and an
# environment that sets none of them behaves exactly as it did before this phase. Asymmetric
# trust is entered by supplying key material deliberately — it is never switched on by a
# default. The policy that reads these names is `apps/api/src/platform/auth/token-policy.ts`.
#
# JWT_ASYMMETRIC_PUBLIC_KEY and JWT_JWKS_URI are MUTUALLY EXCLUSIVE (two key sources would be
# two answers to "which key signed this?"), and the public key must be a PEM public key or
# certificate — private material in this variable is refused at boot, because a verifier that
# holds the signing key has signing authority.
#JWT_ASYMMETRIC_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
#JWT_ASYMMETRIC_KEY_ID=key-2026-09
# A VERIFIER's key source: where this runtime FETCHES the keys Core publishes. Core itself holds
# them and leaves this unset (it is mutually exclusive with the key set below). Since Phase
# 52-ARCH-3C Core serves them at GET /.well-known/jwks.json, so this points at Core —
# https://api.your-domain.example/.well-known/jwks.json, or http://api:3001/.well-known/jwks.json
# for a service on the same network. The `auth.` host shown here before was an EXAMPLE, not a
# topology: there is no separate key-publishing deployment.
#JWT_JWKS_URI=https://api.your-domain.example/.well-known/jwks.json
# ISSUANCE ONLY. The standalone verifier runtime this work enables must NOT set it.
#JWT_ASYMMETRIC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Lifetime of the tokens this process mints. Must not exceed
# HR_ACCEPTED_TOKEN_MAX_TTL_SECONDS, or the platform would mint tokens its own verifiers reject.
#JWT_ASYMMETRIC_ACCESS_TTL_SECONDS=300
#
# Phase 52-ARCH-3C: THE SIGNING KEY SET — the shape to use once more than one key exists.
# Mutually exclusive with every single-key variable above: one key source, so "which key signed
# this?" has one answer. A rotation is an act on THIS configuration, performed by deployment/
# secret-management tooling — there is no rotation endpoint, no rotation permission and no admin
# UI, because there is nothing to mutate in a running process:
#   1. add the NEW key with its "activatedAt" and point JWT_ACTIVE_KEY_ID at it;
#   2. restart: the new key signs, BOTH keys verify, and BOTH are published at
#      /.well-known/jwks.json (which is what a verifier's JWT_JWKS_URI points at);
#   3. wait out the overlap, then remove the OLD key.
# "retireAt" is REQUIRED on every key that is not active (otherwise a rotation could never
# complete), REFUSED on the active one, and must be at least 900s (15 minutes) after the active
# key's "activatedAt": the floor covers this platform's 300s accepted token TTL plus a verifier's
# 300s JWKS cache, so retiring earlier fails the BOOT rather than the verifier. The public half is
# derived from "privateKey" when no "publicKey" is given, and if both are given they must be the
# same key. Keys must be RSA of at least 2048 bits, every entry needs a unique "kid", and a
# misspelled field is refused instead of ignored. Newlines inside a PEM are written as \n.
#JWT_SIGNING_KEYS=[{"kid":"2026-09","privateKey":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----","activatedAt":"2026-09-20T00:00:00Z"},{"kid":"2026-06","publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","retireAt":"2026-09-20T00:15:00Z"}]
# Which entry of the set signs. Required as soon as the set holds any private key; a set of
# public keys only needs no active key (a business runtime that may not sign).
#JWT_ACTIVE_KEY_ID=2026-09
# The migration bridge. `false` (or a past sunset) stops accepting shared-secret tokens;
# acceptance is ALSO disabled automatically once asymmetric keys are configured, so there is
# never a fallback chain.
JWT_LEGACY_HS256_ENABLED=true
# Tokens HR accepts (ADR-0006 §C1(1)): a token whose `exp - iat` exceeds this is rejected.
# Defaults to 300.
HR_ACCEPTED_TOKEN_MAX_TTL_SECONDS=300
# Ceiling on the `perm` claim (ADR-0006 §B4), enforced at issuance and at verification.
# Exceeding it at issuance is an error — a token is never minted with a truncated list.
# Defaults to 200.
MAX_PERMISSIONS_PER_TOKEN=200

# CORS — singular legacy spelling kept for compatibility; the authoritative
# allow-list is CORS_ORIGINS in the 49S-1 section below.
CORS_ORIGIN=http://localhost:3000

# API
API_URL=http://localhost:3001
API_VERSION=v1

# Email — the ONLY names the code reads (src/notifications/email/email.service.ts):
#   SMTP_HOST + SMTP_PORT enable the transport; without them mail is logged to
#   console. SMTP_USER/SMTP_PASS are needed only for authenticated relays
#   (Mailpit accepts anonymous submission, so they stay empty locally).
#   EMAIL_FROM is the sender address.
# The MAIL_* / SMTP_PASSWORD / SMTP_FROM spellings that used to appear here
# configured nothing — they are not read anywhere.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@ariaerp.local

# App
APP_NAME=Aria ERP
APP_VERSION=1.0.0

# AI / Embeddings (Phase 49J-B)
# Real key goes in .env, which is git-ignored. Leaving it blank is safe: the provider warns
# at startup and only fails when an embedding is actually requested.
OPENAI_API_KEY=
# Override only to point at an OpenAI-compatible gateway. Trailing slashes are stripped.
OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL AND DIMENSION ARE ONE UNIT. Vectors are comparable only within a single model at a
# single width, so changing either invalidates everything already stored — that is a
# re-index, not a config edit.
#
# 1536 is text-embedding-3-small's native width, and also a width -3-large can be truncated
# to via the `dimensions` request parameter. Keeping 1536 therefore leaves room to upgrade
# the model later without rewriting existing vectors.
#
# Any pgvector column holding these must be declared vector(1536) to match.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# Per-request ceiling for the embeddings call. Clamped to 1000-120000ms.
EMBEDDING_TIMEOUT_MS=15000

# AES-256-GCM master key for AI provider credentials stored in "AIProviderConfig" (Phase 49J-0).
# Generate with `openssl rand -base64 32` (hex from `openssl rand -hex 32` also works). It must
# DECODE to 32 bytes — a 32-character passphrase is refused, since it carries far less entropy.
#
# THIS KEY IS NOT RECOVERABLE AND NOT ROTATED AUTOMATICALLY. Replacing it makes every already
# stored credential undecryptable, and the affected rows must have their keys re-entered through
# the admin UI. Blank is safe until an administrator saves a provider credential: nothing fails
# at startup, only the encrypt/decrypt call itself.
#
# The variables above remain the BOOTSTRAP path. When no enabled default row exists for a
# capability, resolution falls back to OPENAI_API_KEY / EMBEDDING_MODEL exactly as before, which
# is why the existing embedding behaviour is unchanged. Values are never copied from env into the
# database in either direction.
AI_CONFIG_ENCRYPTION_KEY=

# Automation & Integration Platform (Phase 49L)
#
# THERE IS NO N8N_BASE_URL / N8N_WEBHOOK_SECRET HERE, and that is deliberate. The endpoint,
# the webhook path, the shared secret, the timeout and the retry budget are CORE SETTINGS,
# stored in "IntegrationConfig" and managed through /admin/integrations — because an
# operator must be able to change them, rotate the secret and disable the integration
# without a redeploy, and because §15 forbids the same credential living in both env and
# the database. The secret is encrypted with AI_CONFIG_ENCRYPTION_KEY above: ONE master
# key, ONE secret store.
#
# What DOES belong in env is the deployment-level SSRF policy, because it is a property of
# the network the process runs in rather than of any single integration.
#
# INTEGRATION_ALLOW_PRIVATE_TARGETS permits private/loopback/link-local destinations.
# Default is FALSE — a deployment must opt in explicitly. Set it to `true` (or `1`) for
# local development, where n8n runs on the host (http://localhost:5678) or in the same
# compose network (http://n8n:5678). Leave it UNSET in any deployment where an
# administrator should not be able to point Aria at an internal service: the API process
# can reach redis:6379, rabbitmq:5672, minio:9000 and postgres:5432, none of which
# require authentication from inside the network.
#
# Cloud instance-metadata addresses (169.254.169.254, metadata.google.internal) are
# blocked even when this is `true`. The value is read on EVERY dispatch, not cached at
# boot, so revoking it immediately stops delivery to a previously-allowed loopback target.
INTEGRATION_ALLOW_PRIVATE_TARGETS=false

# Distributed Module Platform (Phase 49M)
#
# THERE IS NOTHING TO ADD HERE, and that absence is the §34 configuration decision rather than an
# oversight. §34 asks that PLATFORM config and MODULE config be kept separate:
#
#   * deployment-level bootstrap/secrets  -> environment (this file)
#   * registered modules, endpoints, enable/disable, tenant scope -> Core Settings, in
#     "ModuleRegistration"/"ModuleInstance", managed through /admin/modules
#   * module credentials -> the SAME encrypted secret store as everything else, i.e. the
#     AES-256-GCM envelope on "ModuleRegistration" under AI_CONFIG_ENCRYPTION_KEY above
#
# So there is deliberately NO MODULE_REGISTRY_URL, no MODULE_SECRET, no HR_MODULE_URL and no
# FINANCE_MODULE_URL. A per-module env var would be exactly the hard-coded deployment assumption the
# phase exists to remove: where a module runs is a ROW the module itself writes when it registers,
# not a variable an operator edits and redeploys.
#
# The two env values 49M DOES read are both already declared above and are shared on purpose:
#   AI_CONFIG_ENCRYPTION_KEY           - encrypts module credentials (ONE master key, ONE store)
#   INTEGRATION_ALLOW_PRIVATE_TARGETS  - the SSRF policy, reused rather than duplicated. Note that
#                                        49M is stricter regardless of this flag: a REMOTE, CENTRAL
#                                        or HYBRID module must use https and must not be a private
#                                        literal, even when private targets are allowed for local
#                                        development.

# Phase 49S-1: Core Security & Production Hardening
#
# CORS_ORIGINS supersedes CORS_ORIGIN. Use a comma or newline separated list of
# allowed browser origins. In production this list is REQUIRED and '*' is
# rejected because credentials are enabled.
# Example:
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000

# Distributed rate limiting (Redis-backed). Public auth endpoints are protected
# by default. These values are optional and fall back to 5 attempts / 15 min.
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900

# Maximum number of concurrent active Redis-backed sessions per user.
# Must be a positive integer. Defaults to 10 if unset.
MAX_ACTIVE_SESSIONS_PER_USER=10

# Trust x-forwarded-for only when the load balancer / proxy is in this CIDR.
# Leave unset to use req.socket.remoteAddress directly.
TRUSTED_PROXY_CIDR=

