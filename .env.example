// .env.local - Frontend Environment Variables

# Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
# GAP-ENV-1: NEXT_PUBLIC_API_URL is inlined at BUILD time (Docker build ARG or
# host `next build`). It must be `<origin>/api` — the code appends `/v1` itself
# (apps/web/src/lib/constants.ts). A bare origin produces /v1/* URLs that exist
# nowhere.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_API_VERSION=v1

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G_XXXXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags
NEXT_PUBLIC_ENABLE_DEMO_BOOKING=true
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_PARTNER_PORTAL=true

# External Services
NEXT_PUBLIC_CALENDAR_API_URL=
